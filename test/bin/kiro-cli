#!/usr/bin/env bash

if [ -n "${FAKE_KIRO_CALL_LOG:-}" ]; then
  printf '%s\n' "$*" >> "$FAKE_KIRO_CALL_LOG"
fi

case "${1:-}" in
  --version)
    printf 'kiro-cli %s\n' "${FAKE_KIRO_VERSION:-2.16.0}"
    ;;
  chat)
    case "${FAKE_KIRO_USAGE_MODE:-valid}" in
      valid)
        printf '\033[1mEstimated Usage\033[0m | resets on 2026-09-01 | KIRO PRO+\n' >&2
        printf '\033[1mCredits\033[0m (%s of %s covered in plan)\n' \
          "${FAKE_KIRO_USED:-140.08}" "${FAKE_KIRO_TOTAL:-2000}" >&2
        ;;
      custom)
        printf 'Usage credits: %s / %s\n' \
          "${FAKE_KIRO_USED:-140.08}" "${FAKE_KIRO_TOTAL:-2000}" >&2
        ;;
      malformed)
        printf 'Credits are currently unavailable\n' >&2
        ;;
      fail)
        printf 'authentication failed\n' >&2
        exit 1
        ;;
    esac
    ;;
  *)
    exit 2
    ;;
esac

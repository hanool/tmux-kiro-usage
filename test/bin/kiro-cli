#!/usr/bin/env bash

if [ -n "${FAKE_KIRO_CALL_LOG:-}" ]; then
  printf '%s\n' "$*" >> "$FAKE_KIRO_CALL_LOG"
fi

[ "$*" = "acp --agent-engine=v3 --auth-method=cli" ] || exit 2

used="${FAKE_KIRO_USED:-140.08}"
total="${FAKE_KIRO_TOTAL:-2000}"

while IFS= read -r request; do
  case "$request" in
    *'"method":"initialize"'*)
      [ "${FAKE_KIRO_USAGE_MODE:-valid}" = "exit" ] && exit 1
      printf '{"jsonrpc":"2.0","method":"_kiro/log","params":{"id":1}}\n'
      printf '{"jsonrpc":"2.0","id":1,"result":{"protocolVersion":1,"agentCapabilities":{}}}\n'
      ;;
    *'"method":"_kiro/account/getUsage"'*)
      case "${FAKE_KIRO_USAGE_MODE:-valid}" in
        valid)
          printf '{"jsonrpc":"2.0","id":2,"result":{"success":true,"data":{"planName":"KIRO PRO+","usageBreakdowns":[{"resourceType":"CREDIT","displayName":"Credits","used":%s,"limit":%s,"percentage":7,"hasLimit":true}],"bonusCredits":[]}}}\n' \
            "$used" "$total"
          ;;
        no-credit)
          printf '{"jsonrpc":"2.0","id":2,"result":{"success":true,"data":{"usageBreakdowns":[]}}}\n'
          ;;
        error)
          printf '{"jsonrpc":"2.0","id":2,"error":{"code":-32601,"message":"Method not found"}}\n'
          ;;
      esac
      ;;
  esac
done
